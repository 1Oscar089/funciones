# ==================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
#
# 1. Copia el archivo:  cp .env.ejemplo .env.local
# 2. Rellena los valores reales en .env.local (no se sube a GitHub)
# 3. Los mismos valores van a GitHub → Settings → Secrets and
#    variables → Actions → "New repository secret"
#
# En Vite SOLO se exponen al cliente las variables con prefijo
# VITE_ (se leen con import.meta.env.VITE_XXX)
# ==================================================================

# ---- Google Sheets (via Apps Script) ----
# URL de la Web App de Apps Script (termina en /exec)
VITE_SHEET_URL=

# (Opcional pero recomendado) clave compartida que tu Apps Script
# validara en cada peticion para que solo TU web pueda usarlo
VITE_SHEET_TOKEN=

# ---- Firebase / Firestore ----
# Consola de Firebase → Configuracion del proyecto → Tus apps → app Web → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=